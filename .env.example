# OpenAI (required)
# OPENAI_API_KEY=...
# Optional custom API base URL
# OPENAI_BASE_URL=
# Optional CA bundle path for TLS verification (useful on macOS/corporate cert chains)
# OPENAI_CA_BUNDLE=
# Text model for assistant chat / heartbeat
OPENAI_TEXT_MODEL=gpt-5-mini
# Realtime model for server-side robot conversation
OPENAI_REALTIME_MODEL=gpt-realtime
# Heartbeat scheduler interval (seconds)
HEARTBEAT_INTERVAL_SECONDS=1800
# Realtime bridge audio gain controls (robot media <-> OpenAI realtime)
# Increase output gain if speech is too quiet.
GRUMPYREACHY_REALTIME_INPUT_GAIN=1.0
GRUMPYREACHY_REALTIME_OUTPUT_GAIN=1.8
# Mic suppression window (seconds) after each assistant audio chunk.
# Helps prevent robot speaker output from looping back into mic input.
# Set 0 to disable suppression.
GRUMPYREACHY_REALTIME_MIC_SUPPRESSION_SECONDS=0.35
# Realtime overlap handling mode:
# - strict_anti_loop: mute mic while assistant is speaking + tail hold (most stable; no barge-in)
# - balanced: fixed suppression window per chunk (allows some interruption)
# - barge_in: no time-based mic suppression
GRUMPYREACHY_REALTIME_TALK_OVERLAP_MODE=strict_anti_loop
# Strict anti-loop post-playback mic hold (seconds). Default 0.9.
GRUMPYREACHY_REALTIME_POST_PLAYBACK_HOLD_SECONDS=0.9
# Realtime output voice effect:
# - chipmunk (default): pitch-up + synthetic robot texture
# - none: no additional output transform
GRUMPYREACHY_REALTIME_VOICE_EFFECT_MODE=chipmunk
# Basic AEC (reference echo suppression) toggle and tuning.
# When enabled, subtracts far-end speaker-correlated energy from mic audio.
GRUMPYREACHY_REALTIME_AEC_ENABLED=true
# Initial far-end delay compensation in milliseconds (tune 80~180ms on device).
GRUMPYREACHY_REALTIME_AEC_DELAY_MS=120
# Subtraction strength (0.0~1.0): higher reduces echo more, but may affect voice.
GRUMPYREACHY_REALTIME_AEC_STRENGTH=0.75
# Minimum normalized correlation (0.0~1.0) to trigger suppression.
GRUMPYREACHY_REALTIME_AEC_CORR_THRESHOLD=0.12
# Deprecated compatibility vars (one-release fallback only):
# LLM_MODEL=
# MODEL_NAME=

# Google Docs (journal) – OAuth credentials path and optional folder filter
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Enable Google Docs API and Drive API; download JSON and save path below.
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json
# Optional: only sync docs from this Drive folder ID (journal folder).
# GOOGLE_DOCS_FOLDER_ID=...

# SQLite DB path (default: ./data/grumpyclaw.db)
# GRUMPYCLAW_DB_PATH=./data/grumpyclaw.db

# Optional: directories to scan for SKILL.md (default: project skills/ and .cursor/skills/). Separate multiple paths with ; (Windows) or : (Unix).
# GRUMPYCLAW_SKILLS_DIR=
# Embedding execution provider(s) for FastEmbed/ONNX Runtime.
# Default is CPUExecutionProvider to avoid GPU device discovery warnings on headless systems.
# Set to auto to let ONNX Runtime choose, or pass a comma-separated provider list.
# GRUMPYCLAW_EMBEDDING_PROVIDERS=CPUExecutionProvider
# Optional: persistent FastEmbed model cache directory.
# Defaults to ./data/fastembed_cache to avoid temp directory cleanup removing model files.
# GRUMPYCLAW_EMBEDDING_CACHE_DIR=./data/fastembed_cache

# grumpyreachy (Reachy Mini integration)
# Observation loop interval in seconds (default 600 = 10 minutes)
# GRUMPYREACHY_OBSERVE_INTERVAL=600
# Enable robot feedback mapping for tool lifecycle events
# GRUMPYREACHY_FEEDBACK_ENABLED=true
# Reachy profile; lite is default for Reachy Mini Lite workflow
# GRUMPYREACHY_REACHY_MODE=lite
# Personality profile (folder under src/grumpyreachy/profiles/ or external dir).
# GRUMPYREACHY_CUSTOM_PROFILE=default
# Optional: paths to external profiles and tools (e.g. ./external_content/external_profiles).
# GRUMPYREACHY_EXTERNAL_PROFILES_DIRECTORY=
# GRUMPYREACHY_EXTERNAL_TOOLS_DIRECTORY=
# Optional: lock to a single profile (ignores GRUMPYREACHY_CUSTOM_PROFILE and UI).
# GRUMPYREACHY_LOCKED_PROFILE=
# Camera: set to false to disable (avoids opencv/v4l2 errors when no capture device).
# GRUMPYREACHY_CAMERA_ENABLED=true
# Camera device index (default 0). If /dev/video0 is not a capture device, try 2 or 4.
# GRUMPYREACHY_CAMERA_INDEX=0
# Optional explicit analyzer status flags for heartbeat summaries.
# If omitted, camera falls back to Linux /dev/video* device detection, audio is not_configured.
# GRUMPYREACHY_CAMERA_ANALYZER_ENABLED=true
# GRUMPYREACHY_AUDIO_ANALYZER_ENABLED=false
# Optional speaker test tone gain (devices/audio/test-speaker), 0.0..1.0
# GRUMPYREACHY_TEST_TONE_GAIN=0.35
# Optional preferred input device substrings (comma-separated, first match wins).
# Default prefers Mac built-in audio first, with Reachy/ReSpeaker fallback.
# GRUMPYREACHY_PREFERRED_INPUT_DEVICE=macbook,built-in,default,reachy mini audio,reachy mini,pollen robotics,microphone,mic,respeaker,seeed-4mic,4mic,voicecard,ac108
# Optional preferred output device substrings (comma-separated).
# Default prefers Mac built-in audio first, with Reachy/ReSpeaker fallback.
# GRUMPYREACHY_PREFERRED_OUTPUT_DEVICE=macbook,built-in,default,reachy mini audio,reachy mini,pollen robotics,speakers,speaker,respeaker,seeed-4mic,4mic,voicecard,ac108

# grumpyadmin web/API (primary entry point for robot + web UI)
# Run grumpyadmin-api alone; it owns the robot connection. Do not run grumpyreachy-run alongside it.
# CORS origin for local React dev server.
# GRUMPYADMIN_CORS_ORIGIN=http://localhost:5173
# Robot action rate limit per action type (seconds).
# GRUMPYADMIN_ROBOT_RATE_LIMIT=1.0
# Require confirm=true when speak text length is >= this threshold.
# GRUMPYADMIN_SPEAK_CONFIRM_THRESHOLD=80
# Auto-start in-process robot runtime when API starts (default: true).
# GRUMPYADMIN_AUTOSTART_ROBOT=true
# Realtime camera image cache directory for temporary input_image context payloads.
# Raw image bytes are removed from SSE/DB events after injection.
# GRUMPYADMIN_REALTIME_IMAGE_CACHE_DIR=data/realtime_image_cache
# Retention for temporary realtime camera cache files (seconds). Default: 7 days.
# GRUMPYADMIN_REALTIME_IMAGE_CACHE_TTL_SECONDS=604800
# Optional: base URL for grumpyreachy-chat when using API mode (default http://localhost:8001).
# GRUMPYADMIN_API_URL=http://localhost:8001
